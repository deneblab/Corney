<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006</NoWarn>
    <FalloutRootDirectory>..\..</FalloutRootDirectory>
    <FalloutScriptDirectory>..\..</FalloutScriptDirectory>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="10.5.0" />
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.2" PrivateAssets="all" />
    <PackageReference Include="Deneblab.AbcVersion" Version="1.1.93" />
    <PackageReference Include="Microsoft.Azure.Storage.Blob" Version="11.2.3" />

  </ItemGroup>
	<ItemGroup>
		<PackageDownload Include="NuGet.CommandLine" Version="[6.12.2]" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="..\..\.github\workflows\pr.yml" />
	</ItemGroup>

</Project>
